# Values are read from the process environment. This file is a reference, not a credential file.
DATABASE_URL=sqlite:///backend/research.db
STORAGE_DIR=backend/storage
MODEL_CHECKPOINT=ml/saved_models/approved.pt
CORS_ORIGINS=http://localhost:7351,http://127.0.0.1:7351
COOKIE_SECURE=false
TORCH_THREADS=4
# Local one-time browser enrollment is off unless explicitly enabled by backend.dev.
ENABLE_LOCAL_SETUP=false
